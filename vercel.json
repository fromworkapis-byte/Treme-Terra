{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix gremio-financeiro ci",
  "buildCommand": "npm --prefix gremio-financeiro run build",
  "outputDirectory": "gremio-financeiro/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
